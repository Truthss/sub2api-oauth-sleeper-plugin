# Required: PostgreSQL connection string for the existing Sub2API database.
# In Docker Compose this usually points to the Postgres service name on the same Docker network.
DATABASE_URL=postgres://sub2api:change-me@postgres:5432/sub2api

# Web server listen address inside the container.
HOST=0.0.0.0
PORT=8080

# Initial defaults used only when the plugin settings row is first created.
# Later changes are stored in plugin_oauth_sleeper_settings and can be edited in the UI.
DEFAULT_SLEEP_THRESHOLD_PERCENT=90
SCAN_INTERVAL_SECONDS=60
INCLUDE_OPENAI=true
INCLUDE_ANTHROPIC=true

# Public path where the plugin is exposed by your reverse proxy.
# Examples:
#   /custom/oauth-sleeper
#   /oauth-sleeper
PUBLIC_BASE_PATH=/custom/oauth-sleeper

# Existing Docker network that can reach Sub2API's PostgreSQL container.
SUB2API_DOCKER_NETWORK=sub2api_sub2api-network
